# ---------------------------------------------------------------------------
# UAP environment template.
# Copy to .env and fill in locally. .env is git-ignored and must never be
# committed. Every value below is intentionally EMPTY.
# ---------------------------------------------------------------------------

APP_ENV=
APP_NAME=
APP_VERSION=

APP_HOST=
APP_PORT=

# ---------------------------------------------------------- data storage
# TWO INDEPENDENT database identities (D-OP101-10 / CF-BB-1 = NEW_STRUCTURE).
# There is NO fallback in either direction: the runtime never reads the
# migration key, and Alembic never reads DATABASE_URL.
#
# RUNTIME application database (D-OP101-10 · CF-BB-3 = A).
# Consumed ONLY by the application runtime (config/settings.py ->
# infrastructure/database/*).
DATABASE_URL=

# ALEMBIC MIGRATION database (CF-BB-2 = A · OI-BB-2).
# Consumed ONLY by migrations (migrations_alembic/env.py). Leave empty to keep
# migrations FAIL-CLOSED (a missing migration DSN raises; it never falls back
# to DATABASE_URL).
UAP_MIGRATION_DATABASE_URL=

REDIS_URL=

SECRET_KEY=

LOG_LEVEL=

AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=

# Expected Alembic revision for the /ready schema gate.
# Authority is the build-time artifact (config/_build_info.py), derived from the
# Alembic graph at image build time. This variable CANNOT override that artifact;
# it exists only as a local development / test fallback. Leave it empty to keep
# readiness fail-closed. Never hardcode a revision value here.
EXPECTED_ALEMBIC_REVISION=

# Provider credentials: empty by design. Never commit a real key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
