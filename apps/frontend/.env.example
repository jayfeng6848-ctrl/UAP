# ---------------------------------------------------------------------------
# UAP frontend environment template (public client configuration ONLY).
#
# Every value here is browser-visible. Never place a secret in a VITE_* key:
# no database credentials, no API keys, no JWT signing secrets, no DSNs.
#
# Development only: the Vite dev server proxies /api, /health, /ready and the
# authentication surface (/me, /sessions, /identity, /devices) to this target.
# Production builds never read this value (Appendix AL H11: static SPA served
# same-origin behind a reverse proxy).
# ---------------------------------------------------------------------------

VITE_API_TARGET=http://localhost:8000
